# =============================================================================
#  Enterprise RAG Agent - configuration
# -----------------------------------------------------------------------------
#  Copy this file to `.env` and fill in the values.  `.env` is git-ignored.
#  Every setting has a safe default in src/enterprise_agent/config.py, so you
#  only need to provide GROQ_API_KEY to get a working system.
# =============================================================================

# -----------------------------------------------------------------------------
# Groq API (required for live LLM calls)
#   Get a key at https://console.groq.com/keys
#   If this is empty the agent automatically runs in OFFLINE mode: retrieval,
#   guardrails, tools and the graph still work, but answers come from a
#   deterministic extractive test double instead of the LLM.
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Models
#   LLM_MODEL      - primary reasoning/answer model
#   LLM_FAST_MODEL - cheap model for routing, grading and query rewriting
#   LLM_JUDGE_MODEL- model used by the evaluation harness (LLM-as-a-judge)
#   Any Groq-hosted model id works, e.g. llama-3.1-8b-instant,
#   llama-3.3-70b-versatile, openai/gpt-oss-20b, qwen/qwen3-32b
# -----------------------------------------------------------------------------
LLM_MODEL=llama-3.3-70b-versatile
LLM_FAST_MODEL=llama-3.1-8b-instant
LLM_JUDGE_MODEL=llama-3.3-70b-versatile

# Deterministic, grounded answers: keep temperature at 0.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

# -----------------------------------------------------------------------------
# Document ingestion
#   CHUNK_SIZE_WORDS / CHUNK_OVERLAP_WORDS control the sliding window applied
#   inside every markdown section.  Overlap keeps a sentence that straddles a
#   boundary retrievable from both chunks.
# -----------------------------------------------------------------------------
KNOWLEDGE_BASE_DIR=knowledge_base
INDEX_DIR=data/index
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=25

# -----------------------------------------------------------------------------
# Hybrid retrieval
#   Final score = weighted Reciprocal Rank Fusion of BM25 (lexical) and the
#   dense vector ranking (semantic).  Weights are normalised internally.
# -----------------------------------------------------------------------------
TOP_K=6
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RRF_K=60

# Pull in the neighbouring chunks of the top hits so a hit that starts
# mid-sentence still has readable context.  Set false to disable.
ENABLE_NEIGHBOR_EXPANSION=true
# Hard cap on the context block handed to the LLM (characters).
MAX_CONTEXT_CHARS=6000

# -----------------------------------------------------------------------------
# Embeddings
#   hashing            - dependency-free feature hashing (default, works offline)
#   sentence-transformers - real semantic embeddings (needs the extra package
#                        and a one-time model download)
# -----------------------------------------------------------------------------
EMBEDDING_BACKEND=hashing
EMBEDDING_DIM=1024
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Agent workflow
#   MAX_TOOL_STEPS      - hard loop guard for tool calling
#   MAX_QUERY_REWRITES  - how many times the agent may rewrite and re-retrieve
#   MIN_GROUNDING_SCORE - output-guard threshold below which the answer is
#                         downgraded to an explicit "insufficient evidence"
# -----------------------------------------------------------------------------
MAX_TOOL_STEPS=4
MAX_QUERY_REWRITES=1
MIN_GROUNDING_SCORE=0.55

# Conversation memory: memory (in-process) or sqlite (survives restarts)
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB=data/checkpoints.sqlite

# -----------------------------------------------------------------------------
# Tools and MCP
#   TOOL_PROVIDER=auto   - try the MCP stdio server, fall back to in-process tools
#                mcp     - require MCP (fails loudly if it cannot start)
#                direct  - always use the in-process registry
# -----------------------------------------------------------------------------
TOOL_PROVIDER=auto
MCP_SERVER_COMMAND=.venv\Scripts\python.exe
MCP_SERVER_MODULE=enterprise_agent.mcp.server
MCP_CALL_TIMEOUT_SECONDS=30
ACTION_DB=data/actions.sqlite

# -----------------------------------------------------------------------------
# Guardrails
# -----------------------------------------------------------------------------
MAX_INPUT_CHARS=2000
REDACT_PII=true
BLOCK_PROMPT_INJECTION=true
REQUIRE_CITATIONS=true
# Emails on this domain are the company's own contact details: they are kept in
# answers (an answer like "report it to security@company.example" needs the
# address) but everything else is redacted.
INTERNAL_EMAIL_DOMAIN=company.example

# -----------------------------------------------------------------------------
# Evaluation
# -----------------------------------------------------------------------------
EVAL_DATASET=evals/golden_set.json
EVAL_TOP_K=5
EVAL_REPORT_DIR=reports
ENABLE_LLM_JUDGE=true

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
